{
  "name": "nexstock",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "description": "NexStock local-first inventory intelligence PWA",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "validate:pages": "node scripts/validate-pages-workflow.mjs && node scripts/validate-pages.mjs",
    "verify:clean": "node scripts/verify-clean-clone.mjs",
    "test": "node --test",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.js",
    "validate:phase-59": "node scripts/validate-phase-59.mjs",
    "validate:phase-60": "node scripts/validate-phase-60.mjs",
    "validate:phase-61": "node scripts/validate-phase-61.mjs",
    "validate:phase-62": "node scripts/validate-phase-62.mjs",
    "validate:phase-63": "node scripts/validate-phase-63.mjs",
    "validate:phase-64": "node scripts/validate-phase-64.mjs",
    "validate:phase-65": "node scripts/validate-phase-65.mjs",
    "validate:phase-66": "node scripts/validate-phase-66.mjs",
    "validate:phase-67": "node scripts/validate-phase-67.mjs",
    "validate:phase-68": "node scripts/validate-phase-68.mjs",
    "validate:phase-69": "node scripts/validate-phase-69.mjs",
    "validate:phase-70": "node scripts/validate-phase-70.mjs",
    "validate:phase-71": "node scripts/validate-phase-71.mjs",
    "validate:phase-72": "node scripts/validate-phase-72.mjs",
    "validate:phase-73": "node scripts/validate-phase-73.mjs",
    "validate:phase-74": "node scripts/validate-phase-74.mjs",
    "validate:phase-75": "node scripts/validate-phase-75.mjs",
    "validate:phase-76": "node scripts/validate-phase-76.mjs",
    "validate:phase-77": "node scripts/validate-phase-77.mjs",
    "validate:phase-78": "node scripts/validate-phase-78.mjs",
    "validate:gates": "node scripts/validate-canonical.mjs",
    "validate": "npm run validate:gates && node --test && npm run test:e2e"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@sparticuz/chromium": "140.0.0",
    "axe-core": "4.13.0"
  }
}
